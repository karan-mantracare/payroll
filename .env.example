# ==============================================================================
# MANTRACARE PAYROLL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Port and Base URL
PORT=80
NEXT_PUBLIC_APP_URL=https://programs.mantracare.com/payrol
NEXT_PUBLIC_BASE_PATH=/payrol

# Turso Database Configuration (libSQL)
# Active environment: 'development' | 'staging' | 'production'
PAYROLL_DB_ENV=development

# For local development with file SQLite: file:local.db
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# TURSO STAGING DATABASE (Development & Testing)
TURSO_STAGING_DATABASE_URL=libsql://[your-staging-db].turso.io
TURSO_STAGING_AUTH_TOKEN=

# TURSO PRODUCTION DATABASE (Live Employee Data — Requires Explicit Production Deployment)
TURSO_PRODUCTION_DATABASE_URL=libsql://[your-production-db].turso.io
TURSO_PRODUCTION_AUTH_TOKEN=

# Programs / MantraCare Platform Handshake
# Live endpoint: https://api.mantracare.com/user/user-info
PROGRAMS_USER_INFO_ENDPOINT=https://api.mantracare.com/user/user-info

# Development / Mocking Flag (set to 'false' in production)
# When true, allows test tokens (e.g. test-token-superadmin, test-token-employee) to resolve without hitting the live Programs API
MOCK_PROGRAMS_API=true

# Session Security Secret (32+ character random secret for cookie encryption & signing)
SESSION_SECRET=dev_session_secret_at_least_32_characters_long_super_secure

# Token Replay & Lifetime Settings
TOKEN_EXPIRY_SECONDS=300
SESSION_EXPIRY_SECONDS=28800

# Audit Hash Chain Salt
AUDIT_LOG_SALT=mantracare_audit_tamper_evident_salt_2026

# AES-256-GCM Application-Level Encryption Keys for Sensitive Fields
# Keys must be cryptographically secure 64-character hexadecimal strings (32 bytes = 256 bits).
# Generate a new production key using: openssl rand -hex 32
PAYROLL_ACTIVE_KEY_VERSION=v1
PAYROLL_ENCRYPTION_KEY_V1=replace_with_64_character_hex_string_32_bytes_long
PAYROLL_ENCRYPTION_KEY_V2=

# Authentication & Two-Factor OTP Configuration
# Development static OTP (123456) is ONLY accepted if NODE_ENV=development and PAYROLL_DEV_STATIC_OTP_ENABLED=true.
# In production, PAYROLL_DEV_STATIC_OTP_ENABLED MUST be false or unset.
PAYROLL_DEV_STATIC_OTP_ENABLED=false
OTP_EXPIRY_SECONDS=900
OTP_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# MantraCare Notify API (OTP Email Delivery)
NOTIFY_EMAIL_TOKEN=
NOTIFY_API_URL=https://api-notify.mantracare.com/api/v1/notifications/trigger



